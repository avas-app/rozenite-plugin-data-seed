{
  "name": "@avasapp/rozenite-plugin-data-seed",
  "version": "0.1.0",
  "description": "Seed fake data into a running React Native app from DevTools — TanStack Query cache entries or HTTP responses, generated from your own TypeScript types.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/avas-app/rozenite-plugin-data-seed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avas-app/rozenite-plugin-data-seed.git"
  },
  "bugs": {
    "url": "https://github.com/avas-app/rozenite-plugin-data-seed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/react-native/cjs/react-native.js",
  "module": "./dist/react-native/react-native.js",
  "types": "./dist/react-native/react-native.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/react-native.d.ts",
      "import": "./dist/react-native/react-native.js",
      "require": "./dist/react-native/cjs/react-native.js"
    },
    "./package.json": "./package.json",
    "./sdk": {
      "development": "./sdk.ts",
      "types": "./dist/sdk/sdk.d.ts",
      "default": "./dist/sdk/sdk.js"
    },
    "./expo": {
      "types": "./expo.ts",
      "default": "./expo.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "!bin/__tests__",
    "sdk.ts",
    "docs",
    "skills",
    "src/shared",
    "!src/shared/__tests__",
    "expo.ts"
  ],
  "keywords": [
    "tanstack-query",
    "react-query",
    "fetch",
    "http",
    "msw",
    "react-native",
    "devtools",
    "rozenite",
    "mocking",
    "fixtures",
    "debugging"
  ],
  "scripts": {
    "build": "rozenite build",
    "dev": "rozenite dev",
    "test": "bun test src/ bin/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json --noEmit && rozenite build",
    "presets": "bun run scripts/build-dev-presets.ts",
    "docs": "bun run scripts/build-token-docs.ts"
  },
  "devDependencies": {
    "@rozenite/agent-bridge": "^2.4.0",
    "@rozenite/agent-shared": "^2.4.0",
    "@rozenite/plugin-bridge": "^2.4.0",
    "@rozenite/ui": "^2.4.0",
    "@rozenite/vite-plugin": "^2.4.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.66.0",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.1.7",
    "axios": "^1.19.0",
    "lucide-react": "^0.263.1",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.1",
    "react-native-web": "^0.21.2",
    "rozenite": "^2.4.0",
    "tailwindcss": "^4.2.2",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "@rozenite/agent-bridge": "^2.2.0",
    "@rozenite/agent-shared": "^2.2.0",
    "@rozenite/plugin-bridge": "^2.2.0",
    "react": "*",
    "react-native": "*",
    "ts-json-schema-generator": ">=2"
  },
  "bin": {
    "data-seed": "./bin/data-seed.mjs"
  },
  "peerDependenciesMeta": {
    "ts-json-schema-generator": {
      "optional": true
    }
  }
}
